<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkNavy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="40dp"
        android:paddingBottom="30dp">

        <!-- Robot Image -->
        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/ic_robot"
            android:layout_marginBottom="20dp"
            android:contentDescription="Forex Robot"/>

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FOREX ROBOT"
            android:textColor="@color/gold"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Signal Bot"
            android:textColor="@color/textGray"
            android:textSize="15sp"
            android:layout_marginBottom="36dp"/>

        <!-- Login Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_login_card"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔐  Secure Login"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp"/>

            <!-- Password input container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Enter Password"
                    android:textColorHint="#506070"
                    android:textColor="@color/white"
                    android:inputType="textPassword"
                    android:paddingLeft="16dp"
                    android:paddingRight="56dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_input"
                    android:textSize="16sp"
                    android:cursorVisible="true"/>

                <ImageView
                    android:id="@+id/ivEye"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:alpha="0.5"
                    android:padding="10dp"
                    android:tint="@color/textGray"/>

            </FrameLayout>

            <!-- LOGIN Button -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="LOGIN"
                android:textColor="@color/darkNavy"
                android:textStyle="bold"
                android:textSize="18sp"
                android:background="@drawable/btn_login"
                android:letterSpacing="0.12"/>

        </LinearLayout>

        <!-- Warning text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️  Unauthorized access is prohibited"
            android:textColor="@color/textGray"
            android:textSize="12sp"
            android:layout_marginTop="28dp"/>

    </LinearLayout>
</ScrollView>
